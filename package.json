{
  "name": "tcalc",
  "private": true,
  "version": "0.1.3",
  "description": "Local-first workspace token calculator, model recommender, and coding-agent optimizer.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "cli": "node apps/cli/dist/index.js",
    "wma": "node apps/cli/dist/index.js",
    "scan:fixtures": "node apps/cli/dist/index.js scan fixtures/small-node-app",
    "test": "vitest run && pnpm --filter @wma/dashboard test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "package:vscode": "pnpm --dir apps/vscode-extension run package",
    "package:vscode:inspect": "node scripts/inspect-vsix.mjs",
    "package:vscode:preflight": "node scripts/check-no-telemetry.mjs && pnpm --dir apps/vscode-extension typecheck && pnpm --dir apps/vscode-extension test",
    "publish:vscode:dry-run": "node scripts/publish-vscode-marketplace.mjs --dry-run",
    "publish:vscode:local": "node scripts/publish-vscode-marketplace.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:all": "pnpm smoke:cli && pnpm smoke:mcp",
    "benchmark:scanner": "node scripts/benchmark-scanner.mjs",
    "test:security": "vitest run packages/mcp-server/tests/security.test.ts packages/scanner/tests/scanWorkspace.test.ts apps/cli/tests/examplesSecurity.test.ts packages/reports/tests/generateMarkdownReport.test.ts packages/repo-map/tests/formatRepoMapMarkdown.test.ts",
    "ci": "node scripts/check-no-telemetry.mjs && pnpm check:action && pnpm build && pnpm test && pnpm lint && pnpm typecheck && pnpm scan:fixtures && pnpm package:vscode && pnpm package:vscode:inspect && pnpm smoke:all",
    "ci:smoke": "pnpm smoke:cli",
    "ci:workspace-report": "node scripts/workspace-report.mjs",
    "check:extension-metadata": "node scripts/check-extension-metadata.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:action": "node scripts/check-action.mjs",
    "publish:open-vsx:dry-run": "node scripts/check-extension-metadata.mjs && pnpm build && pnpm test && pnpm package:vscode && pnpm package:vscode:inspect && echo \"Dry run OK. To publish, run 'pnpm publish:open-vsx:local' with the OPEN_VSX_TOKEN env var set.\"",
    "publish:open-vsx:local": "node scripts/publish-open-vsx.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "latest",
    "@types/node": "latest",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "9.39.1",
    "glob": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "vitest": "latest",
    "yauzl": "latest"
  }
}
