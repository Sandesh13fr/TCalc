{
  "name": "@wma/cli",
  "version": "0.1.4",
  "private": true,
  "description": "Command-line interface for TCalc.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wma": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-catalogs.mjs",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "inspect:artifact": "node scripts/inspect-artifact.mjs"
  },
  "dependencies": {
    "@wma/agent-rules": "workspace:*",
    "@wma/core": "workspace:*",
    "@wma/mcp-server": "workspace:*",
    "@wma/model-catalog": "workspace:*",
    "@wma/recommender": "workspace:*",
    "@wma/repo-map": "workspace:*",
    "@wma/reports": "workspace:*",
    "@wma/scanner": "workspace:*",
    "@wma/tokenizers": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "5.9.3"
  }
}
