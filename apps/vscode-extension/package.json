{
  "name": "tcalc",
  "displayName": "TCalc",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first workspace token calculator, model recommender, and coding-agent optimizer.",
  "publisher": "Sandesh13fr",
  "author": {
    "name": "TCalc"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Programming Languages",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "tokens",
    "model",
    "llm",
    "workspace",
    "tokenizer",
    "recommender",
    "cost",
    "coding-agent",
    "opencode",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sandesh13fr/TCalc"
  },
  "bugs": {
    "url": "https://github.com/Sandesh13fr/TCalc/issues"
  },
  "homepage": "https://tcalc-one.vercel.app/",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:workspaceModelAdvisor.scanWorkspace",
    "onCommand:workspaceModelAdvisor.openDashboard",
    "onCommand:workspaceModelAdvisor.exportReport",
    "onCommand:workspaceModelAdvisor.setWorkspaceGoal",
    "onCommand:workspaceModelAdvisor.compareModels",
    "onCommand:workspaceModelAdvisor.generateAgentRules",
    "onCommand:workspaceModelAdvisor.updateModelCatalog",
    "onCommand:workspaceModelAdvisor.openSettings",
    "onCommand:workspaceModelAdvisor.generateRepoMap",
    "onCommand:workspaceModelAdvisor.showWelcome",
    "onCommand:workspaceModelAdvisor.quickStart",
    "onCommand:workspaceModelAdvisor.generateMcpConfig",
    "onView:tcalc.sidebar"
  ],
  "main": "dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "workspaceModelAdvisor.scanWorkspace",
        "title": "TCalc: Scan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "workspaceModelAdvisor.openDashboard",
        "title": "TCalc: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "workspaceModelAdvisor.exportReport",
        "title": "TCalc: Export Report"
      },
      {
        "command": "workspaceModelAdvisor.setWorkspaceGoal",
        "title": "TCalc: Set Workspace Goal"
      },
      {
        "command": "workspaceModelAdvisor.compareModels",
        "title": "TCalc: Compare Models"
      },
      {
        "command": "workspaceModelAdvisor.generateAgentRules",
        "title": "TCalc: Generate Agent Rules"
      },
      {
        "command": "workspaceModelAdvisor.updateModelCatalog",
        "title": "TCalc: Validate Model Catalog"
      },
      {
        "command": "workspaceModelAdvisor.openSettings",
        "title": "TCalc: Open Settings"
      },
      {
        "command": "workspaceModelAdvisor.generateRepoMap",
        "title": "TCalc: Generate Repo Map"
      },
      {
        "command": "workspaceModelAdvisor.showWelcome",
        "title": "TCalc: Show Welcome"
      },
      {
        "command": "workspaceModelAdvisor.quickStart",
        "title": "TCalc: Quick Start"
      },
      {
        "command": "workspaceModelAdvisor.generateMcpConfig",
        "title": "TCalc: Generate MCP Config"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tcalc",
          "title": "TCalc",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "tcalc": [
        {
          "id": "tcalc.sidebar",
          "name": "Workspace Overview",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "workspaceModelAdvisor.scanWorkspace",
          "when": "view == tcalc.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "workspaceModelAdvisor.openDashboard",
          "when": "view == tcalc.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "TCalc",
      "properties": {
        "wma.defaultGoal": {
          "type": "string",
          "default": "build-mvp",
          "enum": [
            "build-mvp",
            "add-feature",
            "debug",
            "refactor",
            "migration",
            "security-review",
            "test-generation",
            "documentation",
            "architecture-planning",
            "cleanup"
          ],
          "description": "Default workspace goal for model recommendations."
        },
        "wma.privacyMode": {
          "type": "string",
          "default": "local-first",
          "enum": [
            "local-first",
            "cloud-ok"
          ],
          "description": "Privacy mode: prefer local models or allow cloud."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm copy:assets && tsc -b",
    "copy:assets": "node scripts/copy-assets.mjs",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "pnpm test:host",
    "test:host": "pnpm build && node dist/test/runTest.js",
    "package": "pnpm copy:assets && node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@wma/agent-rules": "workspace:*",
    "@wma/core": "workspace:*",
    "@wma/model-catalog": "workspace:*",
    "@wma/recommender": "workspace:*",
    "@wma/repo-map": "workspace:*",
    "@wma/reports": "workspace:*",
    "@wma/scanner": "workspace:*",
    "@wma/tokenizers": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "latest",
    "typescript": "5.9.3"
  }
}
