{
  "name": "@wma/repo-map",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first repo map generator that creates a compact Markdown summary of scanned workspaces for coding agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@wma/core": "workspace:*",
    "@wma/tokenizers": "workspace:*",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
